          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Reserva cruzada responde HTTP 409\", function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "",
              "pm.test(\"El error cumple el contrato de la API\", function () {",
              "    const respuesta = pm.response.json();",
              "",
              "    pm.expect(respuesta.codigo).to.eql(409);",
              "    pm.expect(respuesta.error).to.eql(\"Conflict\");",
              "    pm.expect(respuesta.mensaje).to.be.a(\"string\");",
              "    pm.expect(respuesta.fecha).to.exist;",
              "});",
              "",
              "pm.test(\"El sistema informa el conflicto de horario\", function () {",
              "    const respuesta = pm.response.json();",
              "",
              "    pm.expect(respuesta.mensaje.toLowerCase())",
              "        .to.include(\"cita\");",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
