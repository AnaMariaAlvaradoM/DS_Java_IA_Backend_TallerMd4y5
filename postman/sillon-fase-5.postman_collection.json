    {
      "name": "05 - Verificar disponibilidad después de reservar",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Disponibilidad responde HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"La reserva bloquea horarios cruzados\", function () {",
              "    const respuesta = pm.response.json();",
              "",
              "    const inicioReserva = 10 * 60;",
              "    const finReserva = 10 * 60 + 45;",
              "",
              "    respuesta.horariosLibres.forEach(hora => {",
              "        const partes = hora.split(\":\");",
              "        const inicio = Number(partes[0]) * 60",
              "                     + Number(partes[1]);",
              "",
              "        const fin = inicio + respuesta.duracionMinutos;",
              "",
              "        const seCruza = inicio < finReserva",
              "                     && fin > inicioReserva;",
              "",
              "        pm.expect(seCruza).to.eql(false);",
              "    });",
              "});",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
