    {
      "name": "01 - Consultar catálogo público del salón",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "",
              "pm.test(\"Catálogo público responde HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "",
              "pm.test(\"El catálogo no expone correos electrónicos\", function () {",
              "    pm.expect(pm.response.text()).not.to.include(\"@\");",
              "});",
              "",
              "",
              "pm.test(\"El catálogo contiene 2 servicios y 2 estilistas\", function () {",
              "    const catalogo = pm.response.json();",
              "",
              "    pm.expect(catalogo.servicios).to.be.an(\"array\");",
              "    pm.expect(catalogo.servicios).to.have.lengthOf(2);",
              "",
              "    pm.expect(catalogo.estilistas).to.be.an(\"array\");",
              "    pm.expect(catalogo.estilistas).to.have.lengthOf(2);",
              "});",
